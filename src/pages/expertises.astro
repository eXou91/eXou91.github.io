---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { Image } from 'astro:assets';
import poucImg    from '../../assets/images/expertises/pouce.webp';
import timeImg    from '../../assets/images/expertises/time-left.webp';
import secuImg    from '../../assets/images/expertises/security.webp';
import starImg    from '../../assets/images/expertises/star.webp';
import calImg     from '../../assets/images/expertises/mobile/calendar.webp';
import shakeImg   from '../../assets/images/expertises/mobile/handshake.webp';
import ampouleImg from '../../assets/images/expertises/Ampoule@300x.webp';
import crayonImg  from '../../assets/images/expertises/Crayon@300x.webp';
import immeubleImg from '../../assets/images/expertises/Immeuble@300x.webp';

const services = [
  {
    title: 'Stratégie éditoriale',
    subtitle: 'Structurer l\'intention.',
    body: 'Clarifier le positionnement d\'une opération, faire émerger les messages clés, construire un fil conducteur, aligner les partenaires autour d\'un récit partagé.',
    tags: 'Positionnement d\'opération · concept éditorial · narration territoriale · stratégie concours',
    iconRight: true,
    icon: ampouleImg,
  },
  {
    title: 'Écriture &amp; contenu',
    subtitle: 'Formuler avec précision.',
    body: 'Rendre un projet lisible, crédible et convaincant grâce à des contenus structurés, hiérarchisés et adaptés à leurs destinataires.',
    tags: 'Réponses à concours · dossiers stratégiques · notes d\'intention · rapports · contenus éditoriaux',
    iconRight: false,
    icon: crayonImg,
  },
  {
    title: 'Design &amp; mise en forme',
    subtitle: 'Donner de la force au fond.',
    body: 'Concevoir des documents où la forme soutient vraiment le propos : mise en page, hiérarchisation de l\'information, identité de dossier, éléments graphiques et cohérence d\'ensemble.',
    tags: 'Mise en page de dossiers concours · livrets · rapports · identités graphiques · supports de communication',
    iconRight: true,
    icon: immeubleImg,
  },
];

const benefits = [
  { title: 'Gagner du temps',                   desc: 'J\'interviens au plus près de votre rythme pour alléger votre charge et fluidifier la production de vos dossiers.', icon: timeImg },
  { title: 'Sécuriser le fond',                 desc: 'Je veille à la justesse des messages, à la solidité du contenu et à la cohérence stratégique de vos documents.',     icon: secuImg },
  { title: 'Renforcer la qualité des livrables', desc: 'Chaque document gagne en clarté, en impact et en cohérence pour convaincre durablement.',                           icon: starImg },
];

const formats = [
  { title: 'Mission ponctuelle',     desc: 'Pour un besoin ciblé : rédaction, restauration d\'un dossier, mise à jour, relecture stratégique ou effort sur une phase précise.', icon: calImg   },
  { title: 'Permanence stratégique', desc: 'Un appui régulier au sein de vos équipes pour sécuriser le fond, gagner du temps et renforcer la cohérence des dossiers.',           icon: shakeImg },
];

const audiences = ['Promoteurs', 'Aménageurs', 'Architectes et agences d\'urbanisme', 'Collectivités', 'Entreprises et associations engagées dans la fabrique de la ville'];
---

<Layout
  title="Expertises — A vous la ville"
  description="De la stratégie éditoriale à la mise en forme finale, j'aide les équipes à produire des dossiers clairs, solides et convaincants."
>
  <div class="min-h-screen flex flex-col text-navy bg-cream md:bg-white">

    <Header activePage="expertises" />

    <main class="flex-1">

      <!-- ── Page intro ──────────────────────────────────────── -->
      <section class="px-6 md:px-10 pt-8 md:pt-12 pb-10 md:pb-16">

        <!-- Desktop: two-column intro -->
        <div class="hidden md:grid gap-16" style="grid-template-columns: 55fr 45fr;">
          <div>
            <h1 class="font-extrabold m-0 mb-6 leading-none" style="font-size: clamp(3.5rem, 6vw, 6rem);">
              Expertises
            </h1>
            <p class="font-bold text-[1.05rem] leading-snug m-0">
              De la stratégie éditoriale à la mise en forme finale,
              j'aide les équipes à produire des dossiers clairs, solides et convaincants.
            </p>
          </div>
          <div class="pt-4">
            <p class="text-[10px] font-bold tracking-[0.15em] uppercase text-navy mb-4 m-0">
              Formats d'intervention
            </p>
            <div class="space-y-3 text-[0.8rem] leading-relaxed">
              <p class="m-0">
                <strong>Mission ponctuelle pour un besoin ciblé :</strong> rédaction, restructuration d'un dossier,
                mise en page, mise à jour, relecture stratégique ou effort sur une phase précise.
              </p>
              <p class="m-0">
                <strong>Accompagnement transversal :</strong> De l'amont à la version finale : stratégie éditoriale,
                rédaction, coordination, design et finalisation du document.
              </p>
              <p class="m-0">
                <strong>Permanence stratégique :</strong> Un accompagnement régulier au sein des équipes,
                pour suivre plusieurs sujets dans le temps et intervenir comme ressource embarquée.
              </p>
            </div>
          </div>
        </div>

        <!-- Mobile: single-column intro -->
        <div class="md:hidden">
          <h1 class="font-extrabold m-0 mb-5 leading-none" style="font-size: clamp(2.8rem, 10vw, 4rem);">
            Expertises
          </h1>
          <p class="font-bold text-[0.95rem] leading-snug m-0 mb-4">
            De la stratégie éditoriale à la mise en forme finale,
            j'aide les équipes à produire des dossiers clairs, solides et convaincants.
          </p>
          <p class="text-[0.82rem] leading-relaxed m-0 text-navy">
            Que ce soit pour un besoin ponctuel ou un appui régulier,
            j'interviens à vos côtés pour structurer vos messages, clarifier vos contenus
            et concevoir des documents impactants, au service de vos projets urbains.
          </p>
        </div>
      </section>

      <!-- ── 2 formats (mobile only) ──────────────────────────── -->
      <section class="md:hidden px-6 pb-10">
        <h2 class="font-extrabold text-[1.4rem] leading-none m-0 mb-6">2 formats d'intervention</h2>
        <div class="flex flex-col gap-4">
          {formats.map(({ title, desc, icon }) => (
            <div class="flex gap-4 items-start bg-white border border-gray-100 p-4 rounded-sm">
              <Image src={icon} alt="" class="w-12 h-12 shrink-0 object-contain" aria-hidden="true" />
              <div>
                <p class="font-bold text-[0.9rem] m-0 mb-1">{title}</p>
                <p class="text-[0.78rem] leading-snug m-0 text-navy">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ── 3 expertises (mobile) / service cards (desktop) ──── -->
      <section class="px-6 md:px-10 pb-10 md:pb-16">
        <h2 class="md:hidden font-extrabold text-[1.4rem] leading-none m-0 mb-6">3 expertises</h2>

        <div class="flex flex-col gap-8 md:gap-20">
          {services.map(({ title, subtitle, body, tags, iconRight, icon }) => (
            <div>
              <!-- Mobile card -->
              <div class="md:hidden flex gap-4 items-start bg-white p-4 rounded-md">
                <Image src={icon} alt="" class="w-14 h-14 shrink-0 object-contain" aria-hidden="true" />
                <div>
                  <p class="font-extrabold text-[1rem] m-0 mb-[2px]" set:html={title} />
                  <p class="font-bold text-[0.78rem] text-coral m-0 mb-2">{subtitle}</p>
                  <p class="text-[0.76rem] leading-snug m-0 text-navy">{body}</p>
                </div>
              </div>

              <!-- Desktop card: 3-column [icon-or-spacer | text | icon-or-spacer] -->
              <div class="hidden md:grid grid-cols-[240px_1fr_240px] gap-12 items-center">
                <div class="flex justify-center items-center">
                  {!iconRight
                    ? <Image src={icon} alt="" class="w-48 h-48 object-contain" aria-hidden="true" />
                    : <span />
                  }
                </div>

                <div>
                  <h3
                    class="font-extrabold m-0 mb-2 leading-none"
                    style="font-size: clamp(1.6rem, 2.5vw, 2.4rem);"
                    set:html={title}
                  />
                  <p class="font-bold text-[0.9rem] text-coral m-0 mb-4">{subtitle}</p>
                  <p class="text-[0.85rem] leading-relaxed m-0 mb-3">{body}</p>
                  <p class="text-[0.75rem] text-navy/40 m-0">{tags}</p>
                </div>

                <div class="flex justify-center items-center">
                  {iconRight
                    ? <Image src={icon} alt="" class="w-48 h-48 object-contain" aria-hidden="true" />
                    : <span />
                  }
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ── Permanence stratégique ───────────────────────────── -->
      <section class="bg-cream md:bg-white px-6 md:px-10 py-8 md:py-16">

        <!-- Desktop layout -->
        <div class="hidden md:grid grid-cols-[240px_1fr_240px] gap-12 items-start">
          <div class="flex justify-center">
            <Image src={poucImg} alt="" class="w-full" aria-hidden="true" />
          </div>
          <div>
            <p class="font-normal uppercase italic text-coral m-0 mb-4 leading-tight"
               style="font-size: clamp(1.4rem, 2.8vw, 2.2rem);">
              Mais aussi une offre de présence régulière au sein de vos équipes
            </p>
            <h2 class="font-extrabold text-coral m-0 mb-4 leading-[0.92]"
                style="font-size: clamp(2rem, 4vw, 3.5rem);">
              Permanence stratégique
            </h2>
            <p class="font-bold text-[0.95rem] leading-snug m-0 mb-4 text-coral">
              Un appui régulier au sein de vos équipes, pour sécuriser le fond,
              gagner du temps et renforcer la cohérence des dossiers.
            </p>
            <p class="text-[0.82rem] leading-relaxed m-0 mb-3 text-coral">
              J'interviens aussi sous forme de permanence, quelques jours par mois ou à un rythme
              plus soutenu selon les besoins.
            </p>
            <p class="text-[0.82rem] leading-relaxed m-0 mb-3 text-coral">
              Ce format permet d'accompagner les équipes dans la durée, au plus près de leurs projets,
              en apportant à la fois un regard stratégique, une capacité de rédaction et une mise en forme opérationnelle.
            </p>
            <p class="text-[0.82rem] leading-relaxed m-0 text-coral">
              La permanence peut porter sur la préparation de concours, la structuration de dossiers de candidature,
              la formalisation de supports stratégiques, la coordination légère entre partenaires ou encore la montée
              en qualité éditoriale des productions internes.
            </p>
          </div>
          <div aria-hidden="true" />
        </div>

        <!-- Mobile layout: rounded card -->
        <div class="md:hidden rounded-2xl overflow-hidden flex items-stretch" style="background-color: rgb(240 133 140 / 0.2);">
          <!-- Left: pouce filling full column height with object-cover -->
          <div class="w-[45%] shrink-0">
            <Image
              src={poucImg}
              alt=""
              width={400}
              class="block w-full h-full object-cover object-center"
              aria-hidden="true"
            />
          </div>
          <!-- Right: all content -->
          <div class="flex-1 pt-5 pb-5 pr-4">
            <h2 class="font-extrabold text-coral m-0 mb-2 leading-[0.92]"
                style="font-size: clamp(1.3rem, 5vw, 1.6rem);">
              Permanence stratégique
            </h2>
            <p class="font-bold text-[0.75rem] leading-snug m-0 mb-4 text-coral">
              Un appui régulier au sein de vos équipes, pour sécuriser le fond,
              gagner du temps et renforcer la cohérence des dossiers.
            </p>
            <div class="flex flex-col gap-3">
              {benefits.map(({ title, desc, icon }) => (
                <div class="flex gap-2 items-start">
                  <div class="w-8 shrink-0 mt-0.5">
                    <Image src={icon} alt="" width={32} class="w-full h-auto" aria-hidden="true" />
                  </div>
                  <div>
                    <p class="font-bold text-[0.73rem] m-0 mb-[2px] text-navy">{title}</p>
                    <p class="text-[0.67rem] leading-snug m-0 text-navy">{desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ── Méthode ──────────────────────────────────────────── -->
      <section class="bg-navy text-white px-6 md:px-10 py-12 md:py-16">
        <h2
          class="font-extrabold m-0 mb-8 leading-none"
          style="font-size: clamp(2.5rem, 6vw, 5rem);"
        >
          Méthode
        </h2>

        <div class="md:grid md:gap-16" style="grid-template-columns: 45fr 55fr;">
          <div>
            <p class="font-bold text-[1.05rem] leading-snug m-0 mb-8">
              Une implication aux côtés des équipes, comme partenaire éditorial et stratégique.
            </p>

            <p class="text-[10px] font-bold tracking-[0.15em] uppercase text-white/60 m-0 mb-3">
              Pour qui&nbsp;?
            </p>
            <ul class="list-none m-0 p-0 space-y-1">
              {audiences.map((a) => (
                <li class="text-[0.85rem] flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-coral shrink-0" aria-hidden="true"></span>
                  {a}
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-8 md:mt-0">
            <p class="text-[0.85rem] leading-relaxed m-0 mb-4 text-white/80">
              Chaque intervention s'adapte au contexte du projet, au niveau d'avancement du dossier
              et à l'organisation de l'équipe. Elle peut être ponctuelle ou suivie, autonome ou
              coordonnée avec les architectes, paysagistes, bureaux d'études et équipes développement.
            </p>
            <p class="text-[0.85rem] leading-relaxed m-0 text-white/80">
              L'objectif reste le même : sécuriser le fond autant que la forme, faire gagner du temps
              aux équipes et produire des documents plus clairs, plus cohérents et plus convaincants.
            </p>
          </div>
        </div>
      </section>

      <!-- ── CTA bottom ───────────────────────────────────────── -->
      <section class="px-6 md:px-10 py-14 md:py-20 text-center">
        <p
          class="font-extrabold text-coral m-0 mb-8 leading-[1.1]"
          style="font-size: clamp(1.4rem, 3.5vw, 2.2rem);"
        >
          Vous préparez un concours, un dossier stratégique
          ou vous cherchez un appui régulier au sein de vos équipes&nbsp;?
        </p>
        <a
          href="/contact"
          class="inline-block bg-coral text-white no-underline
                 px-10 py-4 font-extrabold text-[1.1rem]
                 hover:opacity-90 transition-opacity duration-150"
        >
          Discutons-en&nbsp;!
        </a>
      </section>

    </main>

    <Footer />
  </div>
</Layout>
