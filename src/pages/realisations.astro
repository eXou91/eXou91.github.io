---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Recommandation from '@/components/Recommandation.astro';
import { RECOS_PROJETS } from '@/data/recommandations';
import { Image } from 'astro:assets';
import boisHabiteImg      from '../../assets/images/realisations/realisation_bois_habité.webp';
import oreeDesChampsImg   from '../../assets/images/realisations/realisation_orée_des_champs.webp';
import livretBiosourceImg from '../../assets/images/realisations/realisation_livret_biosource.webp';
import anticiperDemainImg from '../../assets/images/realisations/realisation_anticiper_demain.webp';
import rapportRseImg      from '../../assets/images/realisations/realisation_rapport_rse.webp';
import bonVivreImg        from '../../assets/images/realisations/realisation_bon_vivre.webp';
import bookCouvertureImg from '../../assets/images/book/book-couverture.webp';

const projects = [
  {
    category: 'Vers le nouveau bois habité',
    type: 'Réponse à concours',
    desc: 'Concevoir la réponse à un concours en deux tours, sur un territoire nouveau pour le client, en donnant au dossier une écriture et une image qui lui sont propres.',
    tags: "Structuration du propos · identité de dossier · composition · harmonisation visuelle",
    imageLeft: true,
    image: boisHabiteImg,
  },
  {
    category: "À l'orée des champs",
    type: 'Réponse à concours',
    desc: "Construire un dossier de candidature capable de porter des idées fortes avant même qu'un projet architectural ne soit arrêté. Lui donner une identité singulière, pour qu'il se distingue dès la première lecture.",
    tags: 'Récit de candidature · hiérarchisation de contenu · mise en page · direction artistique',
    imageLeft: false,
    image: oreeDesChampsImg,
  },
  {
    category: 'Construire bio et géosourcé',
    type: 'Livret éditorial',
    desc: 'Réaliser un livret consacré aux enjeux du construire bio et géosourcé, avec l\'appui de la directrice développement, grands projets et innovation, puis prolonger ce travail par des temps de sensibilisation animés en interne.',
    tags: 'Vulgarisation · rédaction · structuration de contenu · sensibilisation interne',
    imageLeft: true,
    image: livretBiosourceImg,
    recos: RECOS_PROJETS.livretBiosource,
  },
  {
    category: 'Anticiper demain',
    type: 'Réponse à concours',
    desc: 'Mener la conception d\'un dossier de candidature de premier tour, en co-promotion, pour une consultation aux attentes techniques élevées. Composer avec un programme mixte et des enjeux de durabilité qui structurent l\'ensemble du projet.',
    tags: 'Narration visuelle · valorisation de projet · co-promotion · programme mixte',
    imageLeft: false,
    image: anticiperDemainImg,
  },
  {
    category: 'SECIB Immobilier · Rapport RSE\u00a02025',
    type: 'Rapport institutionnel',
    // Réalisé en 2025 sur l'exercice 2024 : la mention évite que la citation
    // (« rapport d'activité RSE 2024 ») paraisse contredire le titre.
    desc: 'Piloter en autonomie le rapport RSE 2025 de SECIB Immobilier (exercice 2024), de la première idée à la forme finale\u00a0: entretiens avec les équipes, définition de la trame, rédaction et création des éléments graphiques.',
    tags: 'Rapport RSE · entretiens de cadrage · rédaction · trame éditoriale',
    imageLeft: true,
    image: rapportRseImg,
    recos: RECOS_PROJETS.rapportRse,
  },
  {
    category: 'Où il fait bon vivre',
    type: 'Réponse à concours',
    desc: "Accompagner une équipe d'architectes sur l'ensemble du dossier de réponse, dans une logique de production fluide et réactive tout au long du concours.",
    tags: 'Couverture illustrée · rédaction · réactivité · accompagnement d\'équipe',
    imageLeft: false,
    image: bonVivreImg,
  },
];

// Intitulé des recommandations d'un projet (jamais « client » : ce sont des dirigeantes
// avec qui Diane a travaillé, pas des clientes d'À vous la ville).
const libelleRecos = (n: number) => (n > 1 ? 'Recommandations' : 'Recommandation');
---

<Layout
  title="Réalisations · À vous la ville"
  description="De la stratégie éditoriale à la mise en forme finale, j'interviens à toutes les étapes d'un projet."
>
  <div class="min-h-screen flex flex-col text-navy bg-white">

    <Header activePage="realisations" />

    <main class="flex-1">

      <!-- ── Page intro ──────────────────────────────────────── -->
      <section class="px-[18px] md:px-14 pt-1.5 md:pt-8 pb-1 md:pb-10">
        <!-- Même grille que la liste de projets (2 colonnes, gap-12) : sur desktop, la carte
             du book s'aligne sur la colonne texte des projets en dessous. -->
        <div class="md:grid md:grid-cols-2 md:gap-12 md:items-end">
          <div>
            <Eyebrow class="mt-1.5 md:mt-0 mb-3 md:mb-4" />
            <h1 class="page-title font-extrabold mb-3.5 md:mb-4">
              Réalisations.
            </h1>
            <p class="font-bold text-[16px] md:text-[1.15rem] leading-[1.4] md:leading-snug text-navy m-0 mb-3 md:mb-4 max-w-[520px]">
              De la stratégie éditoriale à la mise en forme finale, j'interviens à toutes les étapes d'un projet.
            </p>
            <p class="text-[14px] md:text-[0.97rem] leading-[1.55] md:leading-relaxed mt-0 mb-6 md:mb-0 max-w-[520px] text-grey">
              Réponses à concours, livrets, supports de communication ou documents de présentation&nbsp;: chaque
              réalisation est pensée pour clarifier un propos, structurer l'information et donner une forme
              qui fait au fond.
            </p>
          </div>

          <!-- Accès au book (visible au chargement : pas de .reveal). La couverture, inclinée
               et ombrée, est posée sur l'encart comme un objet ; toute la carte est cliquable
               (lien étiré via ::after), mais le nom accessible reste « Accéder au book ».
               Étiquette en navy et non en coral : le coral sur fond paper passe sous le seuil AA. -->
          <div data-book-carte class="group relative flex items-center gap-4 md:gap-5 lg:gap-6 max-w-[460px] bg-paper rounded-xl md:rounded-[14px] p-4 md:px-6 md:py-6 lg:px-7 mb-[22px] md:mb-0">
            <div class="shrink-0 md:-my-10 lg:-translate-y-7">
              <Image
                src={bookCouvertureImg} width={240} widths={[144, 240]}
                sizes="(min-width: 1024px) 104px, (min-width: 768px) 80px, 64px" loading="eager"
                alt="Couverture du book « Références concours 2023-2026 »"
                class="block w-[64px] md:w-[80px] lg:w-[104px] h-auto rounded-[2px] -rotate-[4deg] ring-1 ring-navy/[0.06]
                       shadow-[0_8px_18px_rgba(41,54,130,0.22)] transition-transform duration-300 ease-out
                       group-hover:-rotate-[1.5deg] group-hover:-translate-y-1"
              />
            </div>
            <div class="min-w-0">
              <p class="text-[10.5px] md:text-[11px] font-bold tracking-[0.08em] uppercase text-navy m-0 mb-1 md:mb-1.5">Le book concours</p>
              <p class="font-bold text-[13.5px] md:text-[0.9rem] lg:text-[0.97rem] leading-[1.35] text-navy text-pretty m-0 mb-2 md:mb-3">
                Deux projets lauréats, trois finalistes&nbsp;: mes réponses à concours en un&nbsp;PDF.
              </p>
              <a href="/book" class="link-underline group-hover:[background-size:100%_1.5px] font-bold text-[13px] text-navy no-underline after:absolute after:inset-0 after:rounded-xl md:after:rounded-[14px]">
                Accéder au book&nbsp;&rarr;
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Project list ────────────────────────────────────── -->
      <section class="px-[18px] md:px-14 pb-2 md:pb-14">
        <div class="flex flex-col gap-[34px] md:gap-[52px] mt-[18px] md:mt-0">
          {projects.map(({ category, type, desc, tags, imageLeft, image, recos }) => (
            <article class="reveal">
              <!-- Mobile: image on top, text below -->
              <div class="md:hidden">
                <div class="group w-full aspect-[4/3] rounded-xl overflow-hidden shadow-[0_8px_20px_rgba(41,54,130,0.16)] mb-3.5">
                  <Image src={image} alt={category} width={780} class="w-full h-full object-cover transition-transform duration-[600ms] ease-out group-hover:scale-[1.05]" />
                </div>
                <h3 class="font-extrabold text-[17px] leading-[1.2] m-0 mb-[5px] tracking-[-0.005em]">{category}</h3>
                <p class="text-[10.5px] font-bold tracking-[0.06em] uppercase text-mute m-0 mb-3">{type}</p>
                <p class="text-[13.5px] leading-[1.58] text-grey m-0 mb-3">{desc}</p>
                <p class="text-[10.5px] leading-[1.5] text-mute m-0">{tags}</p>
                {recos && (
                  <div class="mt-5 pt-4 border-t border-navy/15">
                    <p class="text-[10.5px] font-bold tracking-[0.08em] uppercase text-coral m-0 mb-3">{libelleRecos(recos.length)}</p>
                    <div class="flex flex-col gap-4">
                      {recos.map((r) => <Recommandation variant="note" {...r} />)}
                    </div>
                  </div>
                )}
              </div>

              <!-- Desktop: alternating image/text -->
              <div class={`hidden md:flex gap-12 items-center ${imageLeft ? '' : 'flex-row-reverse'}`}>
                {/* Projet avec recommandations : la colonne texte peut être plus haute que l'image
                    (projet bio : jusqu'à ~1650 px de large) ; l'image se cale alors sur le titre
                    au lieu de flotter. Sans effet quand l'image est la plus haute. */}
                <div class={`group flex-1 aspect-[4/3] rounded-[14px] overflow-hidden shadow-[0_10px_28px_rgba(41,54,130,0.16)] ${recos ? 'md:self-start' : ''}`}>
                  <Image src={image} alt={category} width={1280} class="w-full h-full object-cover transition-transform duration-[600ms] ease-out group-hover:scale-[1.05]" />
                </div>
                <div class="flex-1">
                  <h3 class="font-extrabold text-[1.3rem] leading-tight m-0 mb-1.5 tracking-[-0.005em]">{category}</h3>
                  <p class="text-[11.5px] font-bold tracking-[0.07em] uppercase text-mute m-0 mb-4">{type}</p>
                  <p class="text-[0.9rem] leading-relaxed text-grey m-0 mb-3.5 max-w-[460px]">{desc}</p>
                  <p class="text-[11.5px] text-mute m-0">{tags}</p>
                  {recos && (
                    <div class="mt-6 pt-5 border-t border-navy/15 max-w-[460px]">
                      <p class="text-[11px] font-bold tracking-[0.08em] uppercase text-coral m-0 mb-3.5">{libelleRecos(recos.length)}</p>
                      <div class="flex flex-col gap-5">
                        {recos.map((r) => <Recommandation variant="note" {...r} />)}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- ── CTA bottom — bande navy pleine largeur ───────────── -->
      <section class="reveal bg-navy text-center px-[18px] md:px-14 py-12 md:py-[72px] mt-4 md:mt-10">
        <p class="font-extrabold text-white m-0 mb-[18px] md:mb-6 leading-[1.3] md:leading-[1.25] tracking-[-0.015em] max-w-[640px] mx-auto" style="font-size: clamp(1.25rem, 5.1vw, 1.625rem);">
          Vous préparez un concours, un dossier stratégique ou vous cherchez un appui régulier
          au sein de vos équipes&nbsp;?
        </p>
        <a href="/contact"
           class="flex md:inline-flex items-center justify-center gap-1.5 rounded-full bg-coral text-white no-underline
                  py-3.5 md:py-[15px] px-[18px] md:px-7 font-bold text-[12.5px] tracking-[0.06em] uppercase
                  hover:opacity-90 transition-opacity">
          Discutons-en &rarr;
        </a>
        <p class="m-0 mt-5 md:mt-6">
          <a href="/agence" class="link-underline font-bold text-[13px] text-white no-underline">
            Qui est derrière ces projets &rarr;
          </a>
        </p>
      </section>

    </main>

    <Footer activePage="realisations" />
  </div>
</Layout>
