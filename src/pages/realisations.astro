---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { Image } from 'astro:assets';
import boisHabiteImg      from '../../assets/images/realisations/realisation_bois_habité.webp';
import oreeDesChampsImg   from '../../assets/images/realisations/realisation_orée_des_champs.webp';
import livretBiosourceImg from '../../assets/images/realisations/realisation_livret_biosource.webp';
import anticiperDemainImg from '../../assets/images/realisations/realisation_anticiper_demain.webp';
import rapportRseImg      from '../../assets/images/realisations/realisation_rapport_rse.webp';
import bonVivreImg        from '../../assets/images/realisations/realisation_bon_vivre.webp';

const projects = [
  {
    category: 'Vers le nouveau bois habité',
    type: 'Réponse à concours',
    desc: 'Concevoir la réponse à un concours en deux tours, sur un territoire nouveau pour le client, en donnant au dossier une écriture et une image qui lui sont propres.',
    tags: "Structuration du propos · identité de dossier · composition · harmonisation visuelle",
    imageLeft: true,
    image: boisHabiteImg,
  },
  {
    category: "À l'orée des champs",
    type: 'Réponse à concours',
    desc: "Construire un dossier de candidature capable de porter des idées fortes avant même qu'un projet architectural ne soit arrêté. Lui donner une identité singulière, pour qu'il se distingue dès la première lecture.",
    tags: 'Récit de candidature · hiérarchisation de contenu · mise en page · direction artistique',
    imageLeft: false,
    image: oreeDesChampsImg,
  },
  {
    category: 'Construire bio et géosourcé',
    type: 'Livret éditorial',
    desc: 'Réaliser un livret consacré aux enjeux du construire bio et géosourcé, avec l\'appui de la directrice développement, grands projets et innovation, puis prolonger ce travail par des temps de sensibilisation animés en interne.',
    tags: 'Vulgarisation · rédaction · structuration de contenu · sensibilisation interne',
    imageLeft: true,
    image: livretBiosourceImg,
  },
  {
    category: 'Anticiper demain',
    type: 'Réponse à concours',
    desc: 'Mener la conception d\'un dossier de candidature de premier tour, en co-promotion, pour une consultation aux attentes techniques élevées. Composer avec un programme mixte et des enjeux de durabilité qui structurent l\'ensemble du projet.',
    tags: 'Narration visuelle · valorisation de projet · co-promotion · programme mixte',
    imageLeft: false,
    image: anticiperDemainImg,
  },
  {
    category: 'Secib Immobilier · Rapport RSE 2025',
    type: 'Rapport institutionnel',
    desc: 'Piloter en autonomie le rapport RSE 2025 de SECIB Immobilier, de la première idée à la forme finale : entretiens avec les équipes, définition de la trame, rédaction et création des éléments graphiques.',
    tags: 'Rapport RSE · entretiens de cadrage · rédaction · trame éditoriale',
    imageLeft: true,
    image: rapportRseImg,
  },
  {
    category: 'Où il fait bon vivre',
    type: 'Réponse à concours',
    desc: "Accompagner une équipe d'architectes sur l'ensemble du dossier de réponse, dans une logique de production fluide et réactive tout au long du concours.",
    tags: 'Couverture illustrée · rédaction · réactivité · accompagnement d\'équipe',
    imageLeft: false,
    image: bonVivreImg,
  },
];
---

<Layout
  title="Réalisations — A vous la ville"
  description="De la stratégie éditoriale à la mise en forme finale, j'interviens à toutes les étapes d'un projet."
>
  <div class="min-h-screen flex flex-col text-navy bg-white">

    <Header activePage="realisations" />

    <main class="flex-1">

      <!-- ── Page intro ──────────────────────────────────────── -->
      <section class="px-[18px] md:px-14 pt-1.5 md:pt-8 pb-1 md:pb-10">
        <h1 class="page-title font-extrabold mt-1.5 md:mt-0 mb-3.5 md:mb-4">
          Réalisations.
        </h1>
        <p class="font-bold text-[16px] md:text-[1.15rem] leading-[1.4] md:leading-snug text-navy m-0 mb-3 md:mb-4 max-w-[520px]">
          De la stratégie éditoriale à la mise en forme finale, j'interviens à toutes les étapes d'un projet.
        </p>
        <p class="text-[14px] md:text-[0.97rem] leading-[1.55] md:leading-relaxed mt-0 mb-[22px] md:mb-0 max-w-[520px] text-grey">
          Réponses à concours, livrets, supports de communication ou documents de présentation&nbsp;: chaque
          réalisation est pensée pour clarifier un propos, structurer l'information et donner une forme
          qui fait au fond.
        </p>
      </section>

      <!-- ── Project list ────────────────────────────────────── -->
      <section class="px-[18px] md:px-14 pb-2 md:pb-14">
        <h2 class="font-extrabold text-navy mt-[18px] md:mt-0 mb-3.5 md:mb-7" style="font-size: clamp(1.5rem, 6vw, 1.75rem);">
          6 réalisations
        </h2>

        <div class="flex flex-col gap-[34px] md:gap-[52px]">
          {projects.map(({ category, type, desc, tags, imageLeft, image }) => (
            <article>
              <!-- Mobile: image on top, text below -->
              <div class="md:hidden">
                <div class="w-full aspect-[4/3] rounded-xl overflow-hidden shadow-[0_8px_20px_rgba(41,54,130,0.16)] mb-3.5">
                  <Image src={image} alt={category} class="w-full h-full object-cover" />
                </div>
                <p class="font-extrabold text-[17px] leading-[1.2] m-0 mb-[5px] tracking-[-0.005em]">{category}</p>
                <p class="text-[10.5px] font-bold tracking-[0.06em] uppercase text-mute m-0 mb-3">{type}</p>
                <p class="text-[13.5px] leading-[1.58] text-grey m-0 mb-3">{desc}</p>
                <p class="text-[10.5px] leading-[1.5] text-mute m-0">{tags}</p>
              </div>

              <!-- Desktop: alternating image/text -->
              <div class={`hidden md:flex gap-12 items-center ${imageLeft ? '' : 'flex-row-reverse'}`}>
                <div class="flex-1 aspect-[4/3] rounded-[14px] overflow-hidden shadow-[0_10px_28px_rgba(41,54,130,0.16)]">
                  <Image src={image} alt={category} class="w-full h-full object-cover" />
                </div>
                <div class="flex-1">
                  <p class="font-extrabold text-[1.3rem] leading-tight m-0 mb-1.5 tracking-[-0.005em]">{category}</p>
                  <p class="text-[11.5px] font-bold tracking-[0.07em] uppercase text-mute m-0 mb-4">{type}</p>
                  <p class="text-[0.9rem] leading-relaxed text-grey m-0 mb-3.5 max-w-[460px]">{desc}</p>
                  <p class="text-[11.5px] text-mute m-0">{tags}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- ── CTA bottom ───────────────────────────────────────── -->
      <section class="px-[18px] md:px-14 pt-[30px] pb-2.5 md:py-14 text-center">
        <p class="font-extrabold text-navy m-0 mb-[18px] md:mb-6 leading-[1.3] md:leading-[1.25] tracking-[-0.015em] max-w-[640px] mx-auto" style="font-size: clamp(1.25rem, 5.1vw, 1.625rem);">
          Vous préparez un concours, un dossier stratégique ou vous cherchez un appui régulier
          au sein de vos équipes&nbsp;?
        </p>
        <a href="/contact"
           class="flex md:inline-flex items-center justify-center gap-1.5 rounded-full bg-coral text-white no-underline
                  py-3.5 md:py-[15px] px-[18px] md:px-7 font-bold text-[12.5px] tracking-[0.06em] uppercase
                  hover:opacity-90 transition-opacity">
          Discutons-en &rarr;
        </a>
      </section>

    </main>

    <Footer activePage="realisations" />
  </div>
</Layout>
