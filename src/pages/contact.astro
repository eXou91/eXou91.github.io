---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---

<Layout
  title="Contact — A vous la ville"
  description="Vous préparez un concours, un dossier stratégique, ou vous cherchez un appui régulier au sein de vos équipes ?"
>
  <div class="min-h-screen flex flex-col text-navy bg-white">

    <Header activePage="contact" />

    <main class="flex-1 px-[18px] md:px-14 pt-1.5 md:pt-8 pb-14">

      <div class="md:grid md:gap-[100px] items-start" style="grid-template-columns: 460px 1fr;">

        <!-- Left: heading + intro -->
        <div>
          <h1 class="font-extrabold mt-1.5 md:mt-0 mb-4 md:mb-5 leading-[0.92] md:leading-[0.9] tracking-[-0.015em]" style="font-size: clamp(2.5rem, 10.3vw, 4.75rem);">
            Contact.
          </h1>

          <p class="font-bold text-[16px] md:text-[1.15rem] leading-[1.4] md:leading-snug m-0 mb-3 md:mb-4">
            Vous préparez un concours, un dossier stratégique, ou vous cherchez un appui régulier
            au sein de vos équipes&nbsp;?
          </p>

          <p class="text-[14px] md:text-[15px] leading-[1.55] md:leading-relaxed text-grey m-0 mb-[22px] md:mb-[34px]">
            Décrivez-moi votre projet ou votre besoin. Je vous répondrai dans les 48&nbsp;h.
          </p>

          <!-- Direct contact -->
          <div class="space-y-3.5 md:space-y-4">
            <a
              href="mailto:contact@avouslaville.fr"
              class="flex items-center gap-3 md:gap-3.5 text-[14px] md:text-[0.9rem] font-bold text-navy no-underline hover:text-coral transition-colors"
            >
              <span class="w-[34px] h-[34px] md:w-[38px] md:h-[38px] rounded-full border-[1.5px] border-navy flex items-center justify-center text-[13px]" aria-hidden="true">@</span>
              contact@avouslaville.fr
            </a>
            <a
              href="https://www.linkedin.com/in/avouslaville"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 md:gap-3.5 text-[14px] md:text-[0.9rem] font-bold text-navy no-underline hover:text-coral transition-colors"
            >
              <span class="w-[34px] h-[34px] md:w-[38px] md:h-[38px] rounded-full bg-navy flex items-center justify-center text-white text-[13px] font-bold" aria-hidden="true">in</span>
              LinkedIn
            </a>
          </div>
        </div>

        <!-- Right: contact form -->
        <div class="pt-7 md:pt-0 md:mt-0">
          <form
            id="contact-form"
            method="GET"
            action="mailto:contact@avouslaville.fr"
            class="flex flex-col gap-5 md:gap-[26px]"
            novalidate
          >
            <div>
              <label for="name" class="block text-[11px] md:text-[11.5px] font-bold tracking-[0.05em] md:tracking-[0.06em] uppercase text-navy mb-2 md:mb-2.5">
                Nom / structure
              </label>
              <input
                id="name" name="name" type="text" required
                class="w-full h-[44px] md:h-[46px] rounded-[7px] border border-[#dcdce2] focus:border-navy outline-none px-4 text-[0.85rem] transition-colors"
              />
            </div>

            <div>
              <label for="email" class="block text-[11px] md:text-[11.5px] font-bold tracking-[0.05em] md:tracking-[0.06em] uppercase text-navy mb-2 md:mb-2.5">
                Email
              </label>
              <input
                id="email" name="email" type="email" required
                class="w-full h-[44px] md:h-[46px] rounded-[7px] border border-[#dcdce2] focus:border-navy outline-none px-4 text-[0.85rem] transition-colors"
              />
            </div>

            <div>
              <label for="subject" class="block text-[11px] md:text-[11.5px] font-bold tracking-[0.05em] md:tracking-[0.06em] uppercase text-navy mb-2 md:mb-2.5">
                Objet
              </label>
              <input
                id="subject" name="subject" type="text"
                class="w-full h-[44px] md:h-[46px] rounded-[7px] border border-[#dcdce2] focus:border-navy outline-none px-4 text-[0.85rem] transition-colors"
              />
            </div>

            <div>
              <label for="message" class="block text-[11px] md:text-[11.5px] font-bold tracking-[0.05em] md:tracking-[0.06em] uppercase text-navy mb-2 md:mb-2.5">
                Votre message
              </label>
              <textarea
                id="message" name="message" rows="6" required
                class="w-full h-[120px] md:h-[150px] rounded-[7px] border border-[#dcdce2] focus:border-navy outline-none px-4 py-3 text-[0.85rem] resize-y transition-colors"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full md:w-auto md:self-start bg-coral text-white font-bold text-[12.5px] md:text-[13px] tracking-[0.06em] uppercase
                     rounded-lg px-5 md:px-8 py-[15px] md:py-4 hover:opacity-90 transition-opacity duration-150"
            >
              Envoyer
            </button>
          </form>
        </div>

      </div>
    </main>

    <Footer activePage="contact" />
  </div>
</Layout>

<script is:inline>
  (function () {
    var form = document.getElementById('contact-form');
    if (!form) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();

      var name = form.name.value.trim();
      var email = form.email.value.trim();
      var subject = form.subject.value.trim();
      var message = form.message.value.trim();

      var mailSubject = subject || ('Contact depuis le site — ' + name);
      var mailBody =
        'Nom / structure : ' + name + '\n' +
        'Email : ' + email + '\n\n' +
        message;

      var mailto =
        'mailto:contact@avouslaville.fr' +
        '?subject=' + encodeURIComponent(mailSubject) +
        '&body=' + encodeURIComponent(mailBody);

      window.location.href = mailto;
    });
  })();
</script>
