---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

// Clé publique Web3Forms (elle est visible dans le HTML par conception : c'est un
// identifiant de boîte de réception, pas un secret). Si elle devait être révoquée,
// il suffit d'en régénérer une sur https://web3forms.com — le formulaire retombe
// automatiquement sur l'ouverture du logiciel de messagerie en cas de valeur absente.
const WEB3FORMS_KEY = '79a90915-b326-4592-9a3f-7f9e1dc356e4';
const contactEmail = 'contact@avouslaville.fr';

const champ =
  'w-full h-[44px] md:h-[46px] rounded-[7px] border border-[#dcdce2] focus:border-navy outline-none px-4 text-[0.85rem] transition-colors';
const etiquette =
  'block text-[11px] md:text-[11.5px] font-bold tracking-[0.05em] md:tracking-[0.06em] uppercase text-navy mb-2 md:mb-2.5';
---

<Layout
  title="Contact — A vous la ville"
  description="Vous préparez un concours, un dossier stratégique, ou vous cherchez un appui régulier au sein de vos équipes ?"
>
  <div class="min-h-screen flex flex-col text-navy bg-white">

    <Header activePage="contact" />

    <main class="flex-1 px-[18px] md:px-14 pt-1.5 md:pt-8 pb-14">

      <div class="md:grid md:gap-[100px] items-start" style="grid-template-columns: 460px 1fr;">

        <!-- Left: heading + intro -->
        <div>
          <h1 class="page-title font-extrabold mt-1.5 md:mt-0 mb-4 md:mb-5">
            Contact.
          </h1>

          <p class="font-bold text-[16px] md:text-[1.15rem] leading-[1.4] md:leading-snug m-0 mb-3 md:mb-4">
            Vous préparez un concours, un dossier stratégique, ou vous cherchez un appui régulier
            au sein de vos équipes&nbsp;?
          </p>

          <p class="text-[14px] md:text-[0.97rem] leading-[1.55] md:leading-relaxed text-grey m-0 mb-[22px] md:mb-[34px]">
            Décrivez-moi votre projet ou votre besoin. Je vous répondrai dans les 48&nbsp;h.
          </p>

          <!-- Direct contact -->
          <div class="space-y-3.5 md:space-y-4">
            <a
              href={`mailto:${contactEmail}`}
              class="flex items-center gap-3 md:gap-3.5 text-[14px] md:text-[0.9rem] font-bold text-navy no-underline hover:text-coral transition-colors"
            >
              <span class="w-[34px] h-[34px] md:w-[38px] md:h-[38px] rounded-full border-[1.5px] border-navy flex items-center justify-center text-[13px]" aria-hidden="true">@</span>
              {contactEmail}
            </a>
            <a
              href="https://www.linkedin.com/company/%C3%A0-vous-la-ville/about/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 md:gap-3.5 text-[14px] md:text-[0.9rem] font-bold text-navy no-underline hover:text-coral transition-colors"
            >
              <span class="w-[34px] h-[34px] md:w-[38px] md:h-[38px] rounded-full bg-navy flex items-center justify-center text-white text-[13px] font-bold" aria-hidden="true">in</span>
              LinkedIn
            </a>
          </div>
        </div>

        <!-- Right: contact form -->
        <div class="pt-7 md:pt-0 md:mt-0">
          <form
            id="contact-form"
            method="POST"
            action="https://api.web3forms.com/submit"
            data-key={WEB3FORMS_KEY}
            data-email={contactEmail}
            class="flex flex-col gap-5 md:gap-[26px]"
          >
            <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
            <input type="hidden" name="subject" value="Nouveau message depuis avouslaville.fr" />
            <input type="hidden" name="from_name" value="Site À vous la ville" />
            {/* Piège à robots : invisible pour un humain, rempli par les spambots. */}
            <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

            <div>
              <label for="name" class={etiquette}>Nom / structure</label>
              <input id="name" name="name" type="text" required autocomplete="organization" class={champ} />
            </div>

            <div>
              <label for="email" class={etiquette}>Email</label>
              <input id="email" name="email" type="email" required autocomplete="email" class={champ} />
            </div>

            <div>
              <label for="objet" class={etiquette}>Objet</label>
              <input id="objet" name="objet" type="text" class={champ} />
            </div>

            <div>
              <label for="message" class={etiquette}>Votre message</label>
              <textarea
                id="message" name="message" rows="6" required
                class="w-full h-[120px] md:h-[150px] rounded-[7px] border border-[#dcdce2] focus:border-navy outline-none px-4 py-3 text-[0.85rem] resize-y transition-colors"
              ></textarea>
            </div>

            <button
              id="submit-btn"
              type="submit"
              class="w-full md:w-auto md:self-start bg-coral text-white font-bold text-[12.5px] md:text-[13px] tracking-[0.06em] uppercase
                     rounded-lg px-5 md:px-8 py-[15px] md:py-4 hover:opacity-90 transition-opacity duration-150
                     disabled:opacity-60 disabled:cursor-wait"
            >
              Envoyer
            </button>

            <p id="form-status" hidden role="status" aria-live="polite"
               class="text-[13px] leading-relaxed m-0 rounded-lg px-4 py-3"></p>
          </form>
        </div>

      </div>
    </main>

    <Footer activePage="contact" />
  </div>
</Layout>

<script is:inline>
  (function () {
    var form = document.getElementById('contact-form');
    if (!form) return;

    var btn = document.getElementById('submit-btn');
    var status = document.getElementById('form-status');
    var key = form.dataset.key;
    var email = form.dataset.email;
    var keyManquante = !key || key.indexOf('REMPLACER') === 0;

    function afficher(texte, type) {
      status.innerHTML = texte;
      status.className =
        'text-[13px] leading-relaxed m-0 rounded-lg px-4 py-3 ' +
        (type === 'ok' ? 'bg-paper text-navy font-bold' : 'bg-paper text-grey');
      status.hidden = false;
    }

    // Repli : sans clé configurée, on ouvre le logiciel de messagerie comme avant.
    function replimailto() {
      var corps =
        'Nom / structure : ' + form.name.value.trim() + '\n' +
        'Email : ' + form.email.value.trim() + '\n\n' +
        form.message.value.trim();
      var objet = form.objet.value.trim() || ('Contact depuis le site — ' + form.name.value.trim());
      window.location.href =
        'mailto:' + email + '?subject=' + encodeURIComponent(objet) + '&body=' + encodeURIComponent(corps);
      afficher(
        "Votre logiciel de messagerie devrait s'ouvrir avec le message pré-rempli ; il ne reste qu'à l'envoyer. " +
        "S'il ne s'ouvre pas, écrivez-moi à <a class='text-navy font-bold underline' href='mailto:" + email + "'>" + email + '</a>.',
        'info'
      );
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (typeof form.reportValidity === 'function' && !form.reportValidity()) return;

      if (keyManquante) { replimailto(); return; }

      btn.disabled = true;
      var libelle = btn.textContent;
      btn.textContent = 'Envoi…';
      status.hidden = true;

      fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.success) {
            form.reset();
            afficher('Merci, votre message est bien parti. Je vous réponds sous 48 h.', 'ok');
          } else {
            throw new Error(data.message || 'échec');
          }
        })
        .catch(function () {
          afficher(
            "L'envoi n'a pas abouti. Écrivez-moi directement à " +
            "<a class='text-navy font-bold underline' href='mailto:" + email + "'>" + email + '</a>.',
            'info'
          );
        })
        .finally(function () {
          btn.disabled = false;
          btn.textContent = libelle;
        });
    });
  })();
</script>
