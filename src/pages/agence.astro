---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import { Image } from 'astro:assets';
import studioImg from '../../assets/images/studio/studio.webp';
---

<Layout
  title="L'agence — A vous la ville"
  description="À mi-chemin entre le conseil, l'édition et le design graphique, j'accompagne promoteurs, bailleurs, architectes et élus dans la production de leurs dossiers."
>
  <div class="min-h-screen flex flex-col text-navy bg-white">

    <Header activePage="agence" />

    <main class="flex-1 px-[18px] md:px-14 pt-1.5 md:pt-8 pb-2">

      <!-- ── Desktop: two-column ──────────────────────────────── -->
      <div class="hidden md:grid gap-16 items-start mb-9" style="grid-template-columns: 50fr 50fr;">

        <!-- Left: all text -->
        <div class="max-w-[520px]">
          <Eyebrow class="mb-3.5" />
          <h1 class="page-title font-extrabold m-0 mb-7">
            L'agence.
          </h1>

          <p class="font-bold text-[1.15rem] leading-snug m-0 mb-5">
            À mi-chemin entre le conseil, l'édition et le design graphique, j'accompagne promoteurs, bailleurs,
            architectes et élus dans la production de leurs dossiers&nbsp;: réponses à concours, rapports,
            publications ou accompagnement process.
          </p>

          <p class="text-[0.97rem] leading-relaxed text-grey m-0 mb-5">
            Installée en Bretagne, j'ancre mes missions dans une attention forte aux territoires,
            aux usages et à la manière dont on les raconte.
          </p>

          <p class="text-[0.97rem] leading-relaxed text-grey m-0 mb-5">
            Mon approche est transversale&nbsp;: une solide culture urbaine, une vraie autonomie dans
            l'analyse et la rédaction et une exigence graphique affirmée.
          </p>

          <p class="text-[0.97rem] leading-relaxed text-grey m-0 mb-2.5">J'interviens à toutes les étapes&nbsp;:</p>
          <ul class="list-none m-0 p-0 mb-5 text-[0.97rem] leading-loose text-grey">
            <li><span class="text-navy font-bold mr-1.5">&rarr;</span>de la stratégie éditoriale</li>
            <li><span class="text-navy font-bold mr-1.5">&rarr;</span>à la mise en page finale</li>
            <li><span class="text-navy font-bold mr-1.5">&rarr;</span>en passant par la coordination</li>
            <li><span class="text-navy font-bold mr-1.5">&rarr;</span>et le storytelling du projet</li>
          </ul>

          <p class="text-[0.97rem] leading-relaxed text-grey m-0 mb-5">
            Formée en architecture et urbanisme à l'<b class="text-navy">ENSAPLV</b>, puis en sciences politiques
            à <b class="text-navy">Sciences Po Paris</b>, j'ai passé <b class="text-navy">6&nbsp;ans</b> à répondre
            à des concours et à piloter notamment l'innovation et le marketing produit chez <b class="text-navy">Legendre Immobilier</b>
            puis <b class="text-navy">SECIB Immobilier</b>.
          </p>

          <p class="text-[0.97rem] leading-relaxed text-grey m-0">
            Ce parcours m'a donné une compréhension fine des enjeux urbains, des dynamiques d'acteurs et
            des contraintes de production, avec le réflexe d'intégrer l'IA quand elle fait vraiment gagner
            du temps.
          </p>
        </div>

        <!-- Right: portrait — crop plus vertical pour remplir la hauteur du texte,
             recadré sur Diane (placée à gauche dans la photo). -->
        <div class="w-full overflow-hidden rounded-md" style="aspect-ratio: 4/5;">
          <Image
            src={studioImg}
            alt="Diane Breton, fondatrice de À vous la ville, tenant des ouvrages d'architecture"
            width={3000}
            quality={85}
            class="w-full h-full object-cover"
            style="object-position: 40% center;"
            loading="eager"
          />
        </div>

      </div>

      <!-- ── Mobile: stacked ──────────────────────────────────── -->
      <div class="md:hidden">
        <Eyebrow class="mt-1.5 mb-3" />
        <h1 class="page-title font-extrabold mb-[18px]">
          L'agence.
        </h1>

        <!-- Portrait paysage plein cadre, juste après le titre -->
        <div class="w-full aspect-[3/2] mb-[22px] overflow-hidden rounded-[10px]">
          <Image
            src={studioImg}
            alt="Diane Breton, fondatrice de À vous la ville, tenant des ouvrages d'architecture"
            width={1400}
            class="w-full h-full object-cover"
            style="object-position: center;"
            loading="eager"
          />
        </div>

        <p class="font-bold text-[16px] leading-[1.45] text-navy m-0 mb-4">
          À mi-chemin entre le conseil, l'édition et le design graphique, j'accompagne promoteurs, bailleurs,
          architectes et élus dans la production de leurs dossiers&nbsp;: réponses à concours, rapports,
          publications ou accompagnement process.
        </p>

        <p class="text-[14px] leading-[1.6] text-grey m-0 mb-4">
          Installée en Bretagne, j'ancre mes missions dans une attention forte aux territoires,
          aux usages et à la manière dont on les raconte.
        </p>

        <p class="text-[14px] leading-[1.6] text-grey m-0 mb-4">
          Mon approche est transversale&nbsp;: une solide culture urbaine, une vraie autonomie dans
          l'analyse et la rédaction et une exigence graphique affirmée.
        </p>

        <p class="text-[14px] leading-[1.6] text-grey m-0 mb-2">J'interviens à toutes les étapes&nbsp;:</p>
        <ul class="list-none m-0 p-0 mb-[18px] text-[14px] leading-[1.85] text-grey">
          <li><span class="text-navy font-bold mr-1.5">&rarr;</span>de la stratégie éditoriale</li>
          <li><span class="text-navy font-bold mr-1.5">&rarr;</span>à la mise en page finale</li>
          <li><span class="text-navy font-bold mr-1.5">&rarr;</span>en passant par la coordination</li>
          <li><span class="text-navy font-bold mr-1.5">&rarr;</span>et le storytelling du projet</li>
        </ul>

        <p class="text-[14px] leading-[1.6] text-grey m-0 mb-4">
          Formée en architecture et urbanisme à l'<b class="text-navy">ENSAPLV</b>, puis en sciences politiques
          à <b class="text-navy">Sciences Po Paris</b>, j'ai passé <b class="text-navy">6&nbsp;ans</b> à répondre
          à des concours et à piloter notamment l'innovation et le marketing produit chez <b class="text-navy">Legendre Immobilier</b>
          puis <b class="text-navy">SECIB Immobilier</b>.
        </p>

        <p class="text-[14px] leading-[1.6] text-grey m-0">
          Ce parcours m'a donné une compréhension fine des enjeux urbains, des dynamiques d'acteurs et
          des contraintes de production, avec le réflexe d'intégrer l'IA quand elle fait vraiment gagner
          du temps.
        </p>
      </div>

      <!-- ── CTA band ───────────────────────────────────────────── -->
      <div class="mt-6 md:mt-2.5 mb-2 md:mb-10 bg-paper rounded-[14px] px-5 py-[22px] md:py-9 md:px-11 shadow-[0_2px_10px_rgba(41,54,130,0.10)] md:shadow-none flex flex-col md:flex-row md:items-center md:justify-between gap-3.5 md:gap-6">
        <p class="font-extrabold text-navy m-0" style="font-size: clamp(1.25rem, 5.1vw, 1.625rem);">
          Envie d'en discuter&nbsp;?
        </p>
        <div class="flex flex-col sm:flex-row gap-2.5 md:gap-3.5">
          <a href="/contact"
             class="flex items-center justify-center gap-1.5 rounded-full bg-coral text-white no-underline
                    py-3.5 px-[18px] md:px-6 font-bold text-[12.5px] tracking-[0.06em] uppercase
                    hover:opacity-90 transition-opacity">
            Parler de votre projet &rarr;
          </a>
          <a href="/realisations"
             class="flex items-center justify-center rounded-full border-[1.5px] border-navy text-navy no-underline
                    py-3.5 px-[18px] md:px-6 font-bold text-[12.5px] tracking-[0.06em] uppercase
                    hover:bg-navy hover:text-white transition-colors">
            Voir les réalisations
          </a>
        </div>
      </div>

    </main>

    <Footer activePage="agence" />
  </div>
</Layout>
