---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { Image } from 'astro:assets';
import introWebImg    from '../../assets/images/index/web/intro_index.webp';
import introMobileImg from '../../assets/images/index/mobile/intro_index_mobile.webp';
// Accueil : ancienne photo (buffet + livres archi), volontairement distincte de la
// nouvelle photo de la page agence. Sert le teaser mobile et la signature du hero desktop.
import portraitImg    from '../../assets/images/studio/portrait_accueil.webp';
// Crop serré du visage (depuis cette même ancienne photo) pour l'avatar rond de la signature.
import avatarImg      from '../../assets/images/studio/avatar_accueil.webp';
import Eyebrow from '@/components/Eyebrow.astro';
import Recommandation from '@/components/Recommandation.astro';
import { RECO_EXERGUE, RECOS_COLONNES } from '@/data/recommandations';
import Ouverture from '@/components/Ouverture.astro';

const services = [
  {
    title: 'Réponse à concours',
    desc: "Analyser le dossier de consultation, définir l'angle, construire l'argumentaire qui fait la différence.",
    icon: '<path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4Z"/><path d="M17 5h3a2 2 0 0 1-2 4M7 5H4a2 2 0 0 0 2 4"/>',
  },
  {
    title: 'Stratégie éditoriale',
    desc: "Structurer l'intention, clarifier les messages et construire un fil conducteur.",
    icon: '<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.4.3.6.8.6 1.3V16h6v-.9c0-.5.2-1 .6-1.3A6 6 0 0 0 12 3Z"/>',
  },
  {
    title: 'Écriture et contenu',
    desc: 'Formuler avec précision, rendre lisible et convaincre.',
    icon: '<path d="m17 3 4 4-11 11-5 1 1-5L17 3Z"/>',
  },
  {
    title: 'Design et mise en forme',
    desc: 'Donner de la forme au fond par un design clair, cohérent et impactant.',
    icon: '<rect x="4" y="3" width="16" height="18" rx="1.5"/><path d="M8 8h2M8 12h2M8 16h2M14 8h2M14 12h2M14 16h2"/>',
  },
  {
    title: 'Accompagnement process &amp; IA',
    desc: "Auditer vos méthodes de travail, organiser l'information et intégrer l'IA quand elle fait vraiment gagner du temps.",
    icon: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/>',
    isNew: true,
  },
];

// Hero : les trois piliers de l'activité, alignés sur les convictions de la page Agence
// (Stratégie / Design / Méthode) et sur les pictos de la page Expertises.
const piliers = [
  {
    title: 'Gagner vos concours',
    desc: "Définir l'angle, rédiger et mettre en forme jusqu'au rendu. Aussi pour vos rapports RSE, livrets et autres publications.",
    icon: services[0].icon,
  },
  {
    title: 'Valoriser votre agence',
    desc: "Identité, book de références, mise en récit de vos projets : gagner en visibilité auprès des maîtres d'ouvrage.",
    icon: services[3].icon,
  },
  {
    title: 'Optimiser la manière de travailler',
    desc: "Organiser l'information, fluidifier les process et intégrer l'IA quand elle fait vraiment gagner du temps.",
    icon: services[4].icon,
  },
];
---

<Layout
  title="À vous la ville · Concevoir le récit de vos projets urbains"
  description="Design graphique et édition stratégique au service de la ville, de l'architecture et de l'urbanisme."
>
  <div class="min-h-screen flex flex-col text-navy bg-white">

    <Header />

    <!-- ════════════════════════════════════════════════════════════
         MOBILE  (hidden on md+)
    ═════════════════════════════════════════════════════════════ -->
    <div class="md:hidden px-[18px] pt-1.5 pb-2">
      <Ouverture class="mt-1.5 mb-3.5" />

      <h1 class="font-extrabold leading-[0.92] tracking-[-0.015em] mb-4" style="font-size: clamp(2.1rem, 10vw, 2.6rem);">
        Concevoir le <em class="italic text-coral">récit</em> de vos projets urbains.
      </h1>

      <p class="font-bold text-[15px] leading-[1.4] m-0 mb-4">
        J'accompagne promoteurs, bailleurs, architectes et élus, avec un regard d'architecte
        et 6&nbsp;ans d'expérience côté maîtrise d'ouvrage.
      </p>

      <ul role="list" class="list-none m-0 p-0 flex flex-col gap-3 mb-5">
        {piliers.map(({ title, desc, icon }) => (
          <li class="flex gap-3 items-start">
            <span class="w-[34px] h-[34px] shrink-0 bg-blush rounded-[8px] flex items-center justify-center" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#293682" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
            </span>
            <p class="m-0 text-[13.5px] leading-[1.45] text-grey">
              <b class="block text-[14.5px] text-navy mb-0.5">{title}</b>
              {desc}
            </p>
          </li>
        ))}
      </ul>

      <!-- Mobile CTAs -->
      <div class="flex flex-col gap-2.5 mb-[18px]">
        <a href="/contact"
          class="w-full flex items-center justify-center gap-1.5 rounded-full bg-coral text-white no-underline
                 py-3.5 px-[18px] font-bold text-[12.5px] tracking-[0.06em] uppercase
                 hover:opacity-90 transition-opacity">
          Parler de votre projet &rarr;
        </a>
        <a href="/realisations"
          class="w-full flex items-center justify-center rounded-full border-[1.5px] border-navy text-navy no-underline
                 py-3.5 px-[18px] font-bold text-[12.5px] tracking-[0.06em] uppercase
                 hover:bg-navy hover:text-white transition-colors">
          Voir les réalisations
        </a>
      </div>

      <!-- Image hero mobile -->
      <div class="w-full h-[220px] overflow-hidden rounded-md mb-[26px]">
        <Image
          src={introMobileImg}
          alt="Projet urbain"
          width={780}
          class="w-full h-full object-cover"
          style="object-position: center 42%;"
          loading="lazy"
          fetchpriority="high"
        />
      </div>

      <!-- Ce que je fais -->
      <section class="mb-2">
        <h2 class="font-extrabold text-[24px] leading-none mt-3.5 mb-3.5">Ce que je fais</h2>
        <div class="flex flex-col gap-3">
          {services.map(({ title, desc, icon, isNew }) => (
            <div class="reveal flex gap-3 items-start bg-white border border-[#f0f0f3] shadow-[0_2px_10px_rgba(41,54,130,0.10)] p-4 rounded-[14px]">
              <div class="w-[38px] h-[38px] shrink-0 bg-blush rounded-[9px] flex items-center justify-center" aria-hidden="true">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#293682" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
              </div>
              <div>
                <p class="font-bold text-[15px] text-navy m-0 mb-1" set:html={isNew ? `${title} <span class="inline-block bg-coral text-white text-[9.5px] font-extrabold tracking-[0.06em] uppercase rounded px-1.5 py-0.5 ml-1.5 align-middle">nouveau</span>` : title} />
                <p class="text-[13px] leading-[1.45] m-0 text-grey">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Le studio teaser -->
      <section class="reveal flex gap-3 items-stretch mt-2.5 mb-2">
        <div class="flex-[1.3] flex flex-col justify-center">
          <h3 class="font-extrabold text-[19px] m-0 mb-2 leading-tight">L'agence</h3>
          <p class="text-[13px] leading-[1.5] m-0 mb-2.5 text-grey">
            Je suis architecte et urbaniste de formation, et fondatrice de À vous la ville. Après 6 ans à répondre à des concours
            et à piloter l'innovation et le marketing produit chez Legendre Immobilier puis SECIB Immobilier,
            j'ai choisi de mettre cette double culture, architecture et fabrication concrète de la ville,
            au service des promoteurs, bailleurs, architectes et élus. Je conseille, j'écris, je mets en page,
            et j'accompagne aussi l'optimisation de vos méthodes de travail.
          </p>
          <a href="/agence" class="link-underline inline-block font-bold text-[13px] text-navy no-underline">
            Me découvrir &rarr;
          </a>
        </div>
        <div class="flex-1 rounded-[10px] overflow-hidden">
          <Image src={portraitImg} alt="Diane Breton, fondatrice de À vous la ville" width={1400} quality={82} class="w-full h-full object-cover" loading="lazy" />
        </div>
      </section>
    </div>

    <!-- ════════════════════════════════════════════════════════════
         DESKTOP hero  (hidden below md)
    ═════════════════════════════════════════════════════════════ -->
    {/* Hauteur mini (plancher) : l'écran moins l'en-tête (82px) et ~124px de bande
        « Recommandations » (trois traits + titre), pour signaler la suite sans réduire la photo.
        N'agit que sur les écrans assez hauts pour que le hero soit plus court que ce plancher ;
        sinon sa hauteur naturelle l'emporte et la bande passe sous le pli. */}
    <main class="hidden md:flex flex-1 flex-col px-14 pt-2.5 pb-[60px] min-h-[calc(100svh-206px)]">
      <div class="grid grid-cols-2 gap-14 items-stretch flex-1 min-h-0">

        <!-- Image hero desktop : occupe toute la hauteur disponible jusqu'à la bande Recommandations.
             Le recadrage rogne le ciel et le premier plan végétal, en gardant les
             habitations dans le cadre. -->
        <div class="relative overflow-hidden rounded-md">
          <Image
            src={introWebImg}
            alt="Projet urbain"
            width={1280}
            class="absolute inset-0 w-full h-full object-cover"
            style="object-position: center 42%;"
            loading="lazy"
            fetchpriority="high"
          />
          {/* Décompte posé en pastille sur la photo : il ne prend aucune hauteur dans la
              colonne de texte, pour garder le titre de la bande Recommandations au pli. */}
          <Ouverture class="absolute top-4 left-4 z-10 shadow-[0_4px_14px_rgba(41,54,130,0.18)]" />
        </div>

        <!-- Right: text content, centré verticalement en face de la photo -->
        <div class="flex flex-col justify-center">

          <h1 class="font-extrabold text-navy m-0 leading-[0.92] tracking-[-0.015em]"
              style="font-size: clamp(2.8rem, 4.4vw, 4rem);">
            Concevoir le <em class="italic text-coral">récit</em><br>
            de vos projets urbains.
          </h1>

          <p class="font-bold text-[1.125rem] leading-snug m-0 mt-4 mb-4 max-w-[480px]">
            J'accompagne promoteurs, bailleurs, architectes et élus, avec un regard d'architecte
            et 6&nbsp;ans d'expérience côté maîtrise d'ouvrage.
          </p>

          <ul role="list" class="list-none m-0 p-0 flex flex-col gap-3 mb-5 max-w-[480px]">
            {piliers.map(({ title, desc, icon }) => (
              <li class="flex gap-3.5 items-start">
                <span class="w-[38px] h-[38px] shrink-0 bg-blush rounded-[9px] flex items-center justify-center" aria-hidden="true">
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#293682" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
                </span>
                <p class="m-0 text-[0.9rem] leading-snug text-grey">
                  <b class="block text-[0.97rem] text-navy">{title}</b>
                  {desc}
                </p>
              </li>
            ))}
          </ul>

          <div class="flex flex-col lg:flex-row gap-3 max-w-[280px] lg:max-w-none mb-5">
            <a href="/contact"
               class="flex items-center justify-center gap-1.5 rounded-full bg-coral text-white no-underline
                      py-[15px] px-5 lg:px-7 font-bold text-[12.5px] tracking-[0.06em] uppercase
                      hover:opacity-90 transition-opacity">
              Parler de votre projet &rarr;
            </a>
            <a href="/realisations"
               class="flex items-center justify-center gap-1.5 rounded-full border-[1.5px] border-navy text-navy no-underline
                      py-[15px] px-5 lg:px-7 font-bold text-[12.5px] tracking-[0.06em] uppercase
                      hover:bg-navy hover:text-white transition-colors">
              Voir les réalisations
            </a>
          </div>

          <div class="flex items-center gap-2.5 max-w-[480px]">
            <Image src={avatarImg} alt="Diane Breton" width={140} class="w-[46px] h-[46px] rounded-full object-cover shrink-0" loading="lazy" />
            <span class="text-[12.5px] leading-snug text-grey">
              <b class="text-navy">Diane Breton</b><br>Architecte et urbaniste de formation, fondatrice de À vous la ville
            </span>
          </div>
        </div>
      </div>
    </main>

    {/* ════════════════════════════════════════════════════════════
         RECOMMANDATIONS (mobile + desktop : un seul bloc fluide)
         Dirigeantes avec qui Diane a travaillé (Legendre, SECIB) : PAS des clientes.
         Textes : src/data/recommandations.ts. La plus courte en exergue, les deux
         longues en colonnes calées sur la grille du hero.
         .reveal uniquement sur l'exergue et les colonnes, jamais sur la section ni
         sur l'en-tête : la bande et son titre ne doivent jamais être masqués.
    ═════════════════════════════════════════════════════════════ */}
    <section id="recommandations" aria-labelledby="recommandations-titre"
      class="scroll-mt-24 bg-paper mt-6 md:mt-0 px-[18px] md:px-14 pt-10 pb-11 md:pt-14 md:pb-20">

      <Eyebrow class="mb-3 md:mb-4" />
      <h2 id="recommandations-titre" class="font-extrabold text-navy m-0 mb-2.5 md:mb-3.5 leading-[1.05]"
          style="font-size: clamp(1.5rem, 6vw, 2.125rem);">
        Recommandations
      </h2>
      <p class="text-[14px] md:text-[0.97rem] leading-[1.55] md:leading-relaxed text-grey m-0 max-w-[480px]">
        Voici ce que disent de mon travail trois dirigeantes avec qui j'ai collaboré chez
        Legendre Immobilier puis SECIB Immobilier, avant de créer À&nbsp;vous la&nbsp;ville.
      </p>

      <Recommandation variant="exergue" {...RECO_EXERGUE} class="reveal mt-8 md:mt-12 max-w-[900px]" />

      <div class="reveal mt-9 md:mt-14">
        <div class="grid md:grid-cols-2 gap-y-8 md:gap-x-14">
          {RECOS_COLONNES.map((reco) => <Recommandation variant="colonne" {...reco} />)}
        </div>
        {/* Bouton contact + lien vers toutes les recommandations LinkedIn (côte à côte sur desktop). */}
        <div class="mt-9 md:mt-12 flex flex-col md:flex-row md:items-center gap-5 md:gap-8">
          <a href="/contact"
            class="flex md:inline-flex items-center justify-center gap-1.5 rounded-full bg-coral text-white no-underline
                   py-3.5 md:py-[15px] px-[18px] md:px-7 font-bold text-[12.5px] tracking-[0.06em] uppercase
                   hover:opacity-90 transition-opacity">
            Parler de votre projet &rarr;
          </a>
          <a href="https://www.linkedin.com/in/diane-breton-049884127/details/recommendations/?detailScreenTabIndex=0"
            target="_blank" rel="noopener noreferrer"
            class="link-underline self-center md:self-auto font-bold text-[13px] text-navy no-underline">
            Toutes mes recommandations sur LinkedIn&nbsp;&rarr;<span class="sr-only"> (nouvel onglet)</span>
          </a>
        </div>
      </div>
    </section>

    <script is:inline>
      // Décompte jusqu'à l'ouverture. Un seul script pour les deux bandeaux
      // (mobile + desktop), d'où le querySelectorAll.
      (() => {
        const bandeaux = document.querySelectorAll('[data-ouverture]');
        const JOUR = 24 * 60 * 60 * 1000;

        bandeaux.forEach((bandeau) => {
          const texte = bandeau.querySelector('[data-ouverture-texte]');
          if (!texte) return;
          const restant = new Date(bandeau.dataset.ouverture).getTime() - Date.now();

          // Une fois la date passée, le bandeau annonce l'ouverture au lieu de
          // compter dans le négatif : il n'y a rien à changer dans le code ce jour-là.
          if (restant <= 0) {
            texte.textContent = 'À vous la ville est ouvert';
            return;
          }
          const jours = Math.ceil(restant / JOUR);
          texte.textContent =
            jours === 1
              ? 'Ouverture demain, le 30 septembre'
              : 'Ouverture le 30 septembre · J\u2212' + jours;
        });
      })();
    </script>

    <Footer />
  </div>
</Layout>
