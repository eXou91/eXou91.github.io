---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { Image } from 'astro:assets';
import introWebImg    from '../../assets/images/index/web/intro_index.webp';
import introMobileImg from '../../assets/images/index/mobile/intro_index_mobile.webp';
import ampouleImg     from '../../assets/images/expertises/Ampoule@300x.webp';
import crayonImg      from '../../assets/images/expertises/Crayon@300x.webp';
import immeubleImg    from '../../assets/images/expertises/Immeuble@300x.webp';

const services = [
  { title: 'Stratégie éditoriale',    desc: 'Structurer l\'intention, clarifier les messages et construire un fil conducteur.', icon: ampouleImg  },
  { title: 'Écriture et contenu',     desc: 'Formuler avec précision, rendre lisible et convaincre.',                           icon: crayonImg   },
  { title: 'Design et mise en forme', desc: 'Donner de la forme au fond par un design clair, cohérent et impactant.',           icon: immeubleImg },
];
---

<Layout
  title="A vous la ville — Concevoir le récit de vos projets urbains"
  description="Design graphique & édition stratégique pour la ville, l'architecture et l'urbanisme."
>
  <div class="min-h-screen md:h-screen md:overflow-hidden flex flex-col text-navy bg-paper md:bg-white">

    <Header />

    <!-- ════════════════════════════════════════════════════════════
         MOBILE hero  (hidden on md+)
    ═════════════════════════════════════════════════════════════ -->
    <div class="md:hidden px-6 pt-8 pb-10">
      <h1 class="font-extrabold leading-[0.92] m-0 mb-5" style="font-size: clamp(3rem, 11vw, 3.8rem);">
        Concevoir<br>
        le récit de vos<br>
        projets urbains.
      </h1>

      <h2 class="font-bold text-[0.9rem] leading-snug m-0 mb-3">
        Design graphique &amp; édition stratégique pour la ville, l'architecture et l'urbanisme.
      </h2>

      <p class="text-[0.82rem] leading-relaxed m-0 mb-6">
        À vous la ville accompagne les acteurs publics et privés dans la valorisation de leurs projets.
        Nous transformons la complexité des enjeux urbains en récits clairs, vivants et sensibles.
      </p>

      <!-- Mobile CTAs -->
      <div class="flex flex-col gap-3 mb-8">
        <a href="/realisations"
          class="w-full flex justify-center rounded-full bg-coral text-white no-underline
                 py-4 font-bold text-[11px] tracking-[0.18em] uppercase
                 hover:opacity-90 transition-opacity">
          Voir les réalisations
        </a>
        <a href="/contact"
          class="w-full flex justify-center rounded-full border-2 border-navy text-navy no-underline
                 py-[0.9rem] font-bold text-[11px] tracking-[0.18em] uppercase
                 hover:bg-navy hover:text-white transition-colors">
          Parler de votre projet
        </a>
      </div>

      <!-- Image hero mobile -->
      <div class="w-full overflow-hidden rounded-xl">
        <Image
          src={introMobileImg}
          alt="Projet urbain"
          class="w-full h-auto"
          loading="eager"
        />
      </div>

      <!-- Ce que je fais -->
      <section class="mt-12">
        <h2 class="font-extrabold text-[2rem] leading-none m-0 mb-7">Ce que je fais</h2>
        <div class="flex flex-col gap-3">
          {services.map(({ title, desc, icon }) => (
            <div class="flex gap-4 items-center bg-cream p-4 rounded-xl">
              <Image src={icon} alt="" class="w-12 h-12 shrink-0 object-contain" aria-hidden="true" />
              <div>
                <p class="font-bold text-[0.88rem] m-0 mb-0.5">{title}</p>
                <p class="text-[0.76rem] leading-snug m-0 text-navy">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Le studio teaser -->
      <section class="mt-10 bg-cream rounded-xl overflow-hidden flex">
        <div class="p-5 flex-1 flex flex-col justify-between">
          <div>
            <h2 class="font-extrabold text-[1.4rem] leading-tight m-0 mb-2">Le studio</h2>
            <p class="text-[0.76rem] leading-relaxed m-0 mb-4 text-navy">
              À vous la ville est un studio indépendant, spécialisé dans le conseil, le design
              graphique et l'édition appliquées à l'urbanisme, à l'architecture et à la fabrique de la ville.
            </p>
          </div>
          <a href="/le-studio"
             class="inline-flex items-center gap-2 font-bold text-[0.8rem] text-navy no-underline hover:opacity-60">
            Découvrir le studio <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="bg-gray-200 w-[38%] shrink-0" aria-hidden="true"></div>
      </section>
    </div>

    <!-- ════════════════════════════════════════════════════════════
         DESKTOP hero  (hidden below md)
    ═════════════════════════════════════════════════════════════ -->
    <main class="hidden md:flex flex-1 flex-col px-10 pt-6 pb-8 min-h-0">
      <div class="grid gap-10 h-full" style="grid-template-columns: 42fr 58fr;">

        <!-- Image hero desktop -->
        <div class="overflow-hidden">
          <Image
            src={introWebImg}
            alt="Projet urbain"
            class="w-full h-full object-cover object-center"
            loading="eager"
          />
        </div>

        <!-- Right: text content -->
        <div class="flex flex-col justify-center">
          <h1 class="font-extrabold text-navy m-0 leading-[0.92]"
              style="font-size: clamp(2.6rem, 4.2vw, 4.2rem);">
            Concevoir<br>
            le récit de vos<br>
            projets urbains.
          </h1>

          <!-- Text block: constrained right-aligned -->
          <div class="mt-8 ml-auto w-[55%] text-right space-y-[0.7rem]">
            <h2 class="text-[1.1rem] font-bold leading-snug m-0">
              Design graphique &amp; édition stratégique
              pour la ville, l'architecture et l'urbanisme.
            </h2>
            <p class="text-[0.78rem] leading-relaxed m-0">
              J'accompagne les acteurs de la ville dans la conception et la
              mise en forme de leurs projets.
            </p>
            <p class="text-[0.78rem] leading-relaxed m-0">
              Architecte de formation, forte de 6 ans en réponse à concours
              en promotion immobilière, je combine conseil stratégique,
              rédaction experte et design éditorial pour produire des
              documents clairs, solides et engageants.
            </p>
          </div>

          <!-- CTAs: centered on the full right column -->
          <div class="flex flex-col items-center gap-2 pt-5">
            <a href="/realisations"
               class="inline-flex items-center justify-between w-64 border-2 border-navy text-navy no-underline
                      px-6 py-3 font-bold text-[10.5px] tracking-[0.2em] uppercase
                      hover:bg-navy hover:text-white transition-colors duration-150">
              <span>Réalisations</span>
              <span aria-hidden="true">→</span>
            </a>
            <a href="/contact"
               class="inline-flex items-center justify-between w-64 border-2 border-navy text-navy no-underline
                      px-6 py-3 font-bold text-[10.5px] tracking-[0.2em] uppercase
                      hover:bg-navy hover:text-white transition-colors duration-150">
              <span>Un projet&nbsp;?</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </main>

    <Footer />
  </div>
</Layout>
