---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import { getCollection } from 'astro:content';

// Un article = un fichier .md dans src/content/carnet-de-bord/.
// Le nom du fichier devient l'URL (ex. mon-article.md -> /carnet-de-bord/mon-article).
// Du plus récent au plus ancien ; à date égale, ordre alphabétique stable.
const articles = (await getCollection('carnet-de-bord')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id),
);

const formatDate = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' });
---

<Layout
  title="Carnet de bord — A vous la ville"
  description="Réflexions, méthodes et retours de terrain sur la fabrique éditoriale des projets urbains."
>
  <div class="min-h-screen flex flex-col text-navy bg-white">

    <Header activePage="carnet" />

    <main class="flex-1 px-[18px] md:px-14 pt-1.5 md:pt-8 pb-14">

      <!-- Titre + accroche -->
      <div class="max-w-[780px] mb-[26px] md:mb-9">
        <Eyebrow class="mt-1.5 md:mt-0 mb-3 md:mb-4" />
        <h1 class="page-title font-extrabold mb-[18px] md:mb-5">
          Carnet de bord.
        </h1>
        <p class="font-bold text-[16px] md:text-[1.15rem] leading-[1.4] md:leading-snug m-0 mb-3.5 md:mb-4">
          Réflexions, méthodes et retours de terrain sur la <em class="italic text-coral">fabrique éditoriale</em> des projets urbains.
        </p>
        <p class="text-[14px] md:text-[0.97rem] leading-[1.6] md:leading-relaxed text-grey m-0">
          Ici, je partage ce que j'observe, ce que j'apprends et ce qui me questionne dans mon travail
          quotidien avec les équipes, sur la narration de projet, l'écriture en contexte concours,
          le design éditorial et la manière dont on donne du sens à des dossiers complexes.
        </p>
      </div>

      <!-- Liste des articles -->
      {articles.length > 0 && (
        <div class="mb-[26px] md:mb-16 md:pt-2.5 flex flex-col gap-4 md:gap-5">
          {articles.map((article) => (
            <div class="border border-navy/[0.12] rounded-[14px] md:rounded-2xl bg-white shadow-[0_4px_16px_rgba(41,54,130,0.08)] md:shadow-[0_4px_20px_rgba(41,54,130,0.08)] px-5 py-[22px] md:p-9 flex flex-col gap-2 md:gap-3 max-w-[640px]">
              <span class="inline-flex self-start bg-blush text-navy text-[9.5px] md:text-[10.5px] font-extrabold tracking-[0.05em] uppercase px-2 md:px-2.5 py-[3px] md:py-1 rounded-[5px]">
                {article.data.tag}
              </span>
              <h2 class="font-extrabold text-navy m-0 leading-[1.2] md:leading-[1.15]" style="font-size: clamp(1.125rem, 4.6vw, 1.625rem);">
                {article.data.title}
              </h2>
              <p class="text-[13.5px] md:text-[0.95rem] leading-[1.5] md:leading-relaxed text-grey m-0">
                <span class="md:hidden">{article.data.excerptShort ?? article.data.excerpt}</span><span class="hidden md:inline">{article.data.excerpt}</span>
              </p>
              <div class="flex items-center justify-between mt-1 md:mt-2">
                <span class="text-[11px] md:text-[12px] font-semibold text-mute">{formatDate(article.data.date)}</span>
                <a href={`/carnet-de-bord/${article.id}`} class="link-underline text-[12.5px] md:text-[13px] font-bold text-navy no-underline shrink-0">
                  Lire l'article &rarr;
                </a>
              </div>
            </div>
          ))}
        </div>
      )}

      <!-- État vide -->
      <div class="border-t border-navy/[0.12] pt-8 md:pt-10 flex flex-col items-center text-center gap-4 md:gap-5">
        <div class="flex gap-1.5 md:gap-2 mb-1" aria-hidden="true">
          {Array.from({ length: 3 }).map(() => (
            <div class="w-7 md:w-9 h-[3px] bg-coral rounded-[2px]"></div>
          ))}
        </div>

        <p class="font-extrabold text-navy m-0" style="font-size: clamp(1.3125rem, 5.4vw, 1.75rem);">
          Les prochains articles arrivent bientôt.
        </p>
        <p class="text-[14px] md:text-[0.9rem] leading-[1.55] md:leading-relaxed text-grey m-0 max-w-[520px]">
          En attendant, n'hésitez pas à me contacter si vous avez une question sur ma manière
          de travailler ou sur un projet en particulier.
        </p>
        <a
          href="/contact"
          class="mt-2 inline-flex items-center gap-2 rounded-full border-[1.5px] border-navy text-navy no-underline
                 px-[22px] md:px-6 py-3.5 font-bold text-[12px] md:text-[12.5px] tracking-[0.06em] uppercase
                 hover:bg-navy hover:text-white transition-colors duration-150"
        >
          Me contacter &rarr;
        </a>
      </div>

    </main>

    <Footer activePage="carnet" />
  </div>
</Layout>
