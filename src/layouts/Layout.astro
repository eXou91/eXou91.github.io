---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Image de partage (chemin absolu depuis la racine du site). */
  image?: string;
  /** 'article' pour les billets du carnet de bord, 'website' ailleurs. */
  type?: 'website' | 'article';
}

const {
  title,
  description = "Conseil, concours, design éditorial et optimisation des méthodes de travail pour ceux qui font la ville.",
  image = '/og-image.jpg',
  type = 'website',
} = Astro.props;

// Astro.site est défini dans astro.config.mjs (https://avouslaville.fr)
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="msvalidate.01" content="54C8B191E14B1DC97529A01DA049931D" />
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>

    <!-- Open Graph (LinkedIn, Facebook, Slack…) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="À vous la ville" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="À vous la ville" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="alternate" type="application/rss+xml" title="Carnet de bord — À vous la ville" href="/rss.xml" />
  </head>
  <body class="bg-white text-gray-900 antialiased">
    <slot />
  </body>
</html>
